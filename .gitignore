# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example
# .env.production yalnızca gizli OLMAYAN NEXT_PUBLIC_* değerlerini içerir
# (anon key zaten tarayıcıya gidiyor, erişimi RLS sınırlar). Gizli anahtarlar
# — SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, CRON_SECRET — Vercel panelinden
# ortam değişkeni olarak girilir, buraya asla yazılmaz.
!.env.production

# supabase local
/supabase/.temp
/supabase/.branches

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
